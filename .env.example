PORT=8093

# Same Supabase DATABASE_URL as integration-service (device_tokens table).
DATABASE_URL=postgresql://sharingbridge:sharingbridge@localhost:5432/sharingbridge
# On *.pooler.supabase.com force port: 5432 (session, default) | 6543 (transaction)
# DB_SUPABASE_POOL_6543_4TR_5432_4SESN=5432
# DB_POOLING=true
# DB_POOL_MIN=0
# DB_POOL_MAX=5
# DB_CONNECTION_IDLE_LIFETIME_SECONDS=60
# DB_TIMEOUT_SECONDS=30
# DB_COMMAND_TIMEOUT_SECONDS=30
# DB_RETRY_MAX_ATTEMPTS=3
# DB_RETRY_BASE_DELAY_MS=200

# Must match integration-service CONNECTION_NOTIFY_WEBHOOK_SECRET.
WEBHOOK_SECRET=change-me-shared-with-integration-service

# Firebase Admin — path or inline JSON
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-adminsdk.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

LOG_LEVEL=warn
